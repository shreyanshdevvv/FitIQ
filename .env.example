# Database (PostgreSQL + pgvector)
POSTGRES_USER=fitcoach
POSTGRES_PASSWORD=fitcoach_dev
POSTGRES_DB=fitcoach_db
DATABASE_URL=postgresql://fitcoach:fitcoach_dev@localhost:5432/fitcoach_db

# NestJS Auth
JWT_SECRET=dev-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRATION=7d

# Internal Communication (NestJS <-> FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=dev-internal-secret-token

# LLM & Embeddings (FastAPI AI Service with Google Gemini)
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
